# ╔══════════════════════════════════════════════════════════════════╗
# ║       CrimeGraph AI — Environment Variables                     ║
# ║       Copy this file to .env and fill in your values            ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Database ────────────────────────────────────────────────────────
# SQLite (default for local development)
DATABASE_URL=sqlite:///./crimegraph.db
# PostgreSQL (for production / Render)
# DATABASE_URL=postgresql://user:password@host:5432/crimegraph

# ─── Security ────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=super-secret-crimegraph-key-CHANGE-IN-PRODUCTION

# ─── Environment ─────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ─── CORS Origins ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex for Render subdomains (auto-applied)
# CORS_ORIGIN_REGEX=^https:\/\/.*\.onrender\.com$

# ─── Optional LLM API Keys ──────────────────────────────────────────
# System works fully without these; they enhance the AI assistant
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Demo Data ───────────────────────────────────────────────────────
ENABLE_DEMO_USERS=true
AUTO_SEED_DEMO_DATA=false

# ─── File Upload ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# ─── Frontend (set in Render Static Site environment) ────────────────
# VITE_API_BASE_URL=https://crimegraph-backend.onrender.com

# ─── Docker Compose Only ────────────────────────────────────────────
POSTGRES_USER=crimegraph
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=crimegraph
